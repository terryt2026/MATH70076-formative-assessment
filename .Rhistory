pch = 16,
xlab = "Date",
ylab = "Exceedance (m³/s)",
main = "River flow exceedances over time")
# River flow exceedances above 75 cumecs
exceedances <- riverflow$flow[riverflow$flow > 75] - 75
# Plot each exceedance against the previous exceedance
plot(
exceedances[-length(exceedances)],
exceedances[-1],
xlab = "Previous exceedance (m³/s)",
ylab = "Next exceedance (m³/s)",
pch = 16,
main = "Successive river flow exceedances"
)
max(riverflow$flow)
