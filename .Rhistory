#| echo: FALSE
riverflow <- read.csv("riverflow_2015_2024.csv")
View(riverflow)
#| echo: FALSE
# Convert date variable
riverflow$date <- as.Date(riverflow$date)
# Create year and month variables
riverflow$year <- format(riverflow$date, "%Y")
riverflow$month <- factor(
format(riverflow$date, "%m"),
levels = sprintf("%02d", 1:12),
labels = month.abb
)
# Figure 1: river flow over time
plot(
riverflow$date,
riverflow$flow,
type = "l",
xlab = "Date",
ylab = expression("River flow (m"^3*"/s)")
)
abline(h = 75, lty = 2)
# Figure 2: distribution of river flow by year
boxplot(
flow ~ year,
data = riverflow,
xlab = "Year",
ylab = expression("River flow (m"^3*"/s)"),
outline = FALSE
)
# Extract exceedances above 75
exceedances <- riverflow$flow[riverflow$flow > 75] - 75
# Figure 3: GPD QQ-plot
p <- ppoints(length(exceedances))
theoretical <- qgpd(p, u = 0, sigma = 29.7, xi = 0.62)
plot(
theoretical,
sort(exceedances),
xlab = "Theoretical GPD quantiles",
ylab = "Observed exceedance quantiles"
)
abline(a = 0, b = 1, lty = 2)
# Figure 4: ACF of exceedances
acf(
exceedances,
xlab = "Lag",
ylab = "ACF",
main = ""
)
