riverflow$date <- as.Date(riverflow$date)
View(riverflow)
exceedances <- riverflow$flow[riverflow$flow > 75] - 75
pit <- 1 - (1 + 0.62 * exceedances / 29.7)^(-1 / 0.62)
plot(pit[-length(pit)],
pit[-1],
xlab = expression(U[i]),
ylab = expression(U[i+1]),
pch = 16)
#| echo: FALSE
#| label: fig-flow-exceed
#| fig-cap: "Lag-1 plot of probability integral transformed river flow exceedances."
exceedances <- riverflow$flow[riverflow$flow > 75] - 75
pit <- 1 - (1 + 0.62 * exceedances / 29.7)^(-1 / 0.62)
plot(pit[-length(pit)],
pit[-1],
pch = 16,
xlab = "PIT value (current exceedance)",
ylab = "PIT value (next exceedance)",
main = "Lag-1 Plot of PIT Values")
